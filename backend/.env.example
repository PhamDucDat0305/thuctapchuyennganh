PORT=3000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5500,http://localhost:5501,http://127.0.0.1:5500,http://127.0.0.1:5501
SESSION_SECRET=replace-with-a-long-random-secret

DB_SERVER=localhost
DB_PORT=1433
# Set DB_INSTANCE for a named instance (for example SQLEXPRESS); DB_PORT is then ignored.
DB_INSTANCE=
DB_NAME=job_viet
DB_USER=sql_login_name
DB_PASSWORD=replace-with-your-sql-password
DB_ENCRYPT=false
# Set true for a local SQL Server using a self-signed certificate.
DB_TRUST_CERT=true
